# Device mode (default) needs no server secrets. Everything below is OPTIONAL.
# OCR_ACCESS_CODE=change-to-a-random-code   # when set, clients must send it to use OCR
# OCR_DAILY_CAP=300

# ---- Server mode only (docker-compose.server.yml); generated by scripts/init-env.ps1 ----
# Losing DATA_KEYS makes encrypted server-side data unreadable. Keep a backup somewhere safe.
# DATA_KEYS=1:REPLACE_WITH_32_RANDOM_BYTES_BASE64
# DATA_KEY_ACTIVE=1
# PHONE_PEPPER=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD

# ---- Trying a real OCR engine from a laptop (optional; the default stays the free mock engine) ----
# Option A: Gemini API, free tier available (free key from https://aistudio.google.com, no credit card)
# OCR_BACKEND=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=            # empty = code default; model IDs are retired periodically
# Privacy: on the free tier Google may use receipt photos to improve its products. Demo use only.

# ---- Cloud Run ----
# There is no .env in the cloud: the variables above are set by scripts/deploy-cloudrun.ps1 (or `gcloud run deploy`),
# see docs/cloud-deployment.md. On Cloud Run, Vertex AI credentials come from the service account, not a token.
