# MODE PERANGKAT (default) tidak butuh rahasia server apa pun. Semua di bawah ini OPSIONAL.
# OCR_ACCESS_CODE=ganti-dengan-kode-acak   # bila diisi, klien wajib mengirimnya untuk memakai OCR
# OCR_DAILY_CAP=300

# ---- hanya untuk MODE SERVER (docker-compose.server.yml); dibuat otomatis oleh scripts/init-env.ps1 ----
# Kehilangan DATA_KEYS = data terenkripsi di server tidak bisa dibaca lagi. Cadangkan di tempat aman.
# DATA_KEYS=1:GANTI_DENGAN_32_BYTE_ACAK_BASE64
# DATA_KEY_ACTIVE=1
# PHONE_PEPPER=GANTI_DENGAN_32_BYTE_ACAK_BASE64
# POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK

# CLOUD: di GCP, OCR_ACCESS_CODE disimpan di Secret Manager dan di-inject ke Cloud Run sebagai env.
