# Disalin menjadi `.env` oleh scripts/init-env.ps1 (dengan nilai acak). JANGAN commit `.env`.
# Kehilangan DATA_KEYS = data terenkripsi (nomor HP, nama, catatan) tidak bisa dibaca lagi. Cadangkan di tempat aman.
DATA_KEYS=1:GANTI_DENGAN_32_BYTE_ACAK_BASE64
DATA_KEY_ACTIVE=1
PHONE_PEPPER=GANTI_DENGAN_32_BYTE_ACAK_BASE64
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK

# CLOUD: di GCP nilai-nilai rahasia di atas disimpan di Secret Manager dan di-inject ke Cloud Run sebagai env.
# CLOUD: Rotasi kunci data: tambahkan "2:<kunci baru>" ke DATA_KEYS (pisahkan koma), lalu ubah DATA_KEY_ACTIVE=2.
